{
  "name": "finca-mamas-garden-web",
  "version": "0.3.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-info.mjs && next build",
    "start": "firebase emulators:start --only hosting --config ../../firebase.deploy.json --project surco-finca",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/test-api-client.mjs && node scripts/test-firebase-models.mjs",
    "test:e2e": "playwright test",
    "test:firestore": "node scripts/test-workforce-firestore.mjs",
    "test:firebase-browser": "node scripts/test-workforce-browser.mjs"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "lucide-react": "1.62.0",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
