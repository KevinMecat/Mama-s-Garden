#!/usr/bin/env bash
set -euo pipefail
python scripts/check_repository.py
scanner="$(git config --get security.gitleaksPath || printf '%s' gitleaks)"
command -v "$scanner" >/dev/null || { echo 'Instalar gitleaks antes de subir.' >&2; exit 1; }
"$scanner" git . --redact --no-banner --max-archive-depth=3 --log-opts="--all"
